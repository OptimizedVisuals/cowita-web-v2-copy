# ============================================================================
#  CoWiTa — server-side environment variables
# ============================================================================
#  Copy to .env.local for local development (`vercel env pull` on Vercel).
#  NEVER commit a real value. Set these in Vercel → Project → Settings →
#  Environment Variables (separately for Preview and Production).
# ============================================================================

# --- Supabase (database + admin auth) ---------------------------------------
# Project Settings → API. The service role key bypasses Row Level Security and
# must only ever exist on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# --- Email (Resend) ---------------------------------------------------------
# Only the server needs this. Verify the sending domain first and add its
# SPF, DKIM and DMARC records.
RESEND_API_KEY=re_your_key
FROM_EMAIL=CoWiTa <no-reply@cowita.org>
ADMIN_EMAIL=info@cowita.org

# --- Abuse protection -------------------------------------------------------
# Cloudflare Turnstile: the public site key lives in js/config.js;
# the secret key stays here.
TURNSTILE_SECRET_KEY=your-turnstile-secret

# --- Privacy / security -----------------------------------------------------
# Random long string used to hash IP addresses so raw IPs are never stored.
# Generate with: openssl rand -hex 32
IP_HASH_PEPPER=replace-with-a-long-random-string

# Comma-separated list of origins allowed to post to the API.
ALLOWED_ORIGINS=https://cowita.org,https://www.cowita.org

# Canonical site URL used in emails and links.
SITE_URL=https://cowita.org

# --- Retention / cron -------------------------------------------------------
# Bearer token Vercel Cron sends to /api/admin/retention.
CRON_SECRET=replace-with-a-long-random-string
# Days after which a submission is deleted (default 730).
RETENTION_DAYS=730

# --- Error tracking (GlitchTip) ---------------------------------------------
# GlitchTip is Sentry-protocol compatible. Free hosted tier gives 1,000
# events/month. Leave unset to disable error tracking (tests, local dev).
# Wire-up: api/_lib/sentry.mjs.
GLITCHTIP_DSN=